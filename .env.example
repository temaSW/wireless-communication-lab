# Optional translator settings. Do not commit real secrets.

# MyMemory works without a key. Supplying an email can raise the free quota.
MYMEMORY_EMAIL=

# LibreTranslate is free when self-hosted or when using a public instance that
# does not require a key.
LIBRETRANSLATE_URL=http://127.0.0.1:5000
LIBRETRANSLATE_KEY=
